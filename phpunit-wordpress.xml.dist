<?xml version="1.0" encoding="UTF-8"?>
<!--
  Integration tests against WordPress and its test suite (PHPUnit 9.6, which the WordPress test
  suite supports). Run by the shared quality.yml with wordpress-tests: true; see README.md to run
  them locally. Coverage covers the whole plugin, the legacy engine included.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/wordpress/bootstrap.php"
         colors="true"
         convertDeprecationsToExceptions="false"
         beStrictAboutOutputDuringTests="false">
    <testsuites>
        <testsuite name="wordpress">
            <directory suffix="Test.php">tests/wordpress</directory>
        </testsuite>
    </testsuites>
    <coverage includeUncoveredFiles="true" processUncoveredFiles="false">
        <include>
            <directory suffix=".php">core</directory>
            <directory suffix=".php">includes</directory>
            <directory suffix=".php">modules</directory>
            <file>avpvh-broken-link-checker.php</file>
            <file>init.php</file>
            <file>config.php</file>
        </include>
    </coverage>
</phpunit>
